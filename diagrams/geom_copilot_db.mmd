erDiagram
    projects_projects["projects.projects (Proyecto 3D y Estado del Agente)"] {
        varchar id PK "ID único de conversación y proyecto"
        bigint tenant_id "ID de inquilino (default 0)"
        bigint user_id "ID de usuario propietario (default 0)"
        varchar mode "DESIGNER | LEARNER"
        varchar project_name "Nombre del Proyecto"
        text objective "Objetivo arquitectónico de la sesión"
        varchar status "IDLE | RUNNING | COMPLETED | FAILED"
        varchar model_llm FK "FK a system.llm_models.id (gpt-6-luna | gpt-6.1-sol)"
        varchar model_effort "Nivel de razonamiento preferido (low | medium | high | xhigh | max)"
        varchar measurement_system "IMPERIAL | METRIC (Preferencia de unidades configurada en el proyecto)"
        jsonb geom_memory "Memoria y contexto continuo sintetizado por el agente"
        jsonb project_subcategories "Familias / subcategorías convergentes del proyecto ([POSTFRAME, PORCH])"
        jsonb permanent_files "Archivos preservados permanentemente (máx 10 y 50 MB)"
        timestamptz created_at "Fecha de creación"
        timestamptz updated_at "Última actividad"
    }

    projects_history["projects.history (Últimas 10 Versiones por Proyecto)"] {
        varchar project_id PK,FK "FK a projects.projects.id"
        bigint version_id PK "1...n incremental independiente por proyecto"
        varchar updated_by "USER | GEOM"
        jsonb project_data "Snapshot del AST geométrico en esta versión"
        varchar model_llm "Modelo LLM activo al generar el snapshot"
        varchar model_effort "Nivel de razonamiento activo al generar el snapshot"
        timestamptz created_at "Momento del commit de la versión"
    }

    projects_events["projects.events (Historial de Mensajes / Eventos)"] {
        varchar project_id PK,FK "FK a projects.projects.id"
        int event_id PK "1...n secuencial independiente por proyecto"
        varchar owner "USER_MESSAGE | GEOM_MESSAGE | TOOL_EXECUTION"
        varchar model_llm FK "FK a system.llm_models.id (modelo ejecutado en este turno)"
        varchar model_effort "Nivel de razonamiento ejecutado en este turno (low | medium | high | xhigh | max)"
        varchar measurement_system "IMPERIAL | METRIC (Unidades activas en este turno)"
        jsonb message "Contenido íntegro estructurado (text, thought, ops)"
        jsonb metadata "Telemetría y consumo (tokens, cache, reasoningEffort, latency)"
        jsonb files "Archivos adjuntos temporales (sliding window 50 eventos)"
        timestamptz created_at "Timestamp del evento"
    }

    system_llm_models["system.llm_models (Catálogo de Modelos LLM Conectados)"] {
        varchar id PK "gpt-6-luna | gpt-6.1-sol (Modelos activos y verificados)"
        varchar name "Nombre comercial (GPT-6 Luna, GPT-6.1 Sol)"
        varchar provider "OPENAI | ANTHROPIC | GOOGLE"
        int max_tokens "Límite de tokens de contexto (32768)"
        boolean is_active "Estado activo y conectado en el backend"
        jsonb reasoning_efforts "Niveles de razonamiento admitidos ([low, medium, high, xhigh, max])"
        varchar default_reasoning_effort "Nivel de razonamiento por defecto (low)"
        timestamptz created_at "Fecha de registro"
    }

    system_prompts["system.prompts (Super Prompt Canónico)"] {
        varchar id PK "ID canónico del prompt (canonical)"
        text content "Texto completo del sistema con directivas"
        varchar content_hash "Hash SHA-256 para verificación de integridad"
        varchar version "Versión del prompt activa (v196...)"
        varchar schema_version "Versión de esquema destino (2.0.0)"
        jsonb history "Arreglo inline de versiones previas [{version, content, updated_at}]"
        timestamptz updated_at "Momento de la última sincronización"
    }

    system_capabilities["system.capabilities (Catálogo de Capabilities y Tools)"] {
        varchar id PK "product_instantiate | product_save | product_get | db_query..."
        varchar driver "BACKEND | FRONT"
        varchar mode "ALL | DESIGNER | LEARNER"
        varchar name "Nombre legible de la capability"
        text description "Guía semántica para el modelo"
        jsonb parameters "JSON Schema para Function Calling"
        jsonb example_call "Ejemplo canónico de llamada"
        boolean is_active "Estado activo en el backend"
        timestamptz created_at "Fecha de registro"
        timestamptz updated_at "Última actualización"
    }

    knowledge_areas["knowledge.areas (Catálogo de Áreas de Conocimiento)"] {
        varchar id PK "Identificador canónico del área (STRUCTURES, FOUNDATIONS)"
        varchar name "Nombre de la disciplina o área técnica"
        text description "Descripción técnica del área"
        int version "Versión incremental del área"
        jsonb history "Arreglo inline de versiones previas [{version, name, description, updated_at}]"
        timestamptz created_at "Fecha de creación"
        timestamptz updated_at "Última modificación"
    }

    knowledge_families["knowledge.families (Familias Paramétricas de Productos)"] {
        varchar id PK "Código canónico de familia (CONPD, LVLBR, PFRAM...)"
        varchar area_id FK "FK a knowledge.areas.id"
        varchar name "Nombre genérico comercial de la familia"
        text description "Descripción técnica de la familia"
        varchar status "DRAFT | PUBLISHED | ARCHIVED"
        int version "Versión incremental del conocimiento de familia"
        jsonb definition "CONTRATO CANÓNICO (3 secciones: geometry, construction, estimation)"
        jsonb history "Arreglo inline de versiones previas [{version, definition, updated_at}]"
        varchar model_llm "Modelo LLM que definió o mutó la familia"
        varchar model_effort "Nivel de razonamiento utilizado"
        timestamptz created_at "Fecha de creación"
        timestamptz updated_at "Última modificación"
    }

    knowledge_products["knowledge.products (Catálogo Canónico de Productos)"] {
        varchar code PK "Código canónico métrico (PK, ej. CONPD_RND16X04)"
        varchar imp_code UK "Código comercial imperial (ej. CONPD_16X4)"
        varchar family_code FK "FK a knowledge.families.id"
        varchar name "Nombre en sistema métrico"
        varchar imp_name "Nombre en sistema imperial"
        text description "Descripción técnica métrica"
        text imp_description "Descripción comercial imperial"
        varchar status "DRAFT | PUBLISHED | ARCHIVED"
        int version "Versión incremental del producto"
        jsonb definition "CONTRATO CANÓNICO (5 secciones: meta, inputs, geometry, materials, estimation)"
        jsonb history "Arreglo inline de versiones previas [{version, definition, updated_at}]"
        varchar model_llm "Modelo LLM que definió o mutó el producto"
        varchar model_effort "Nivel de razonamiento utilizado"
        timestamptz created_at "Fecha de creación"
        timestamptz updated_at "Última actualización"
    }

    projects_projects ||--o{ projects_history : "project_id"
    projects_projects ||--o{ projects_events : "project_id"
    system_llm_models ||--o{ projects_projects : "model_llm"
    system_llm_models ||--o{ projects_events : "model_llm"
    knowledge_areas ||--o{ knowledge_families : "area_id"
    knowledge_families ||--o{ knowledge_products : "family_code"
